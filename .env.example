# Copia este archivo a ".env" (para el modo local) y rellena tu clave.
#   PowerShell:  copy .env.example .env
# El archivo .env está en .gitignore: NUNCA se sube al repo.

# Obligatoria: tu clave de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Opcional: modelo a usar. gpt-4o-mini es barato y suficiente para la POC.
# Para más calidad: gpt-4o
OPENAI_MODEL=gpt-4o-mini

# Opcional y AVANZADO: apunta a otro proveedor compatible con OpenAI.
# Déjalo comentado para usar OpenAI. Ejemplos:
#   Groq:              https://api.groq.com/openai/v1
#   Azure AI Foundry:  https://<tu-recurso>.services.ai.azure.com/models
# OPENAI_BASE_URL=
